<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RubikCube.Maui.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="RubikCube.Maui.MainPage"
             Title="Rubik's Cube 4D Solver">

    <Grid ColumnDefinitions="400,*,320" RowDefinitions="*">

        <!-- Left Panel - Controls -->
        <ScrollView Grid.Column="0" Padding="10">
            <VerticalStackLayout Spacing="10">

                <!-- Control Buttons Row 1 -->
                <HorizontalStackLayout Spacing="5">
                    <Button x:Name="ShuffleBtn" Text="Shuffle" Clicked="OnShuffleClicked" WidthRequest="80" />
                    <Button x:Name="SolveBtn" Text="Solve!" Clicked="OnSolveClicked" WidthRequest="80" />
                    <Button x:Name="StopBtn" Text="Stop" Clicked="OnStopClicked" WidthRequest="80" BackgroundColor="OrangeRed" />
                    <Button x:Name="ResetBtn" Text="Reset" Clicked="OnResetClicked" WidthRequest="80" />
                </HorizontalStackLayout>

                <!-- Dimension Control (3D to 5D) -->
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="Dimension:" VerticalOptions="Center" WidthRequest="75" />
                    <Slider x:Name="DimensionSlider"
                            Minimum="3" Maximum="5" Value="3"
                            WidthRequest="150"
                            ValueChanged="OnDimensionSliderChanged" />
                    <Label x:Name="DimensionLabel" Text="3" VerticalOptions="Center" WidthRequest="30" />
                </HorizontalStackLayout>

                <!-- Size Control (2 to 12) -->
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="Size:" VerticalOptions="Center" WidthRequest="75" />
                    <Slider x:Name="SizeSlider"
                            Minimum="2" Maximum="12" Value="3"
                            WidthRequest="150"
                            ValueChanged="OnSizeSliderChanged" />
                    <Label x:Name="SizeLabel" Text="3" VerticalOptions="Center" WidthRequest="30" />
                </HorizontalStackLayout>

                <!-- Shuffle Moves Control -->
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="Shuffle:" VerticalOptions="Center" WidthRequest="75" />
                    <Slider x:Name="ShuffleMoveSlider"
                            Minimum="5" Maximum="100" Value="30"
                            WidthRequest="150"
                            ValueChanged="OnShuffleMoveSliderChanged" />
                    <Label x:Name="ShuffleMoveLabel" Text="30" VerticalOptions="Center" WidthRequest="30" />
                </HorizontalStackLayout>

                <!-- Transparency Toggle -->
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Transparency:" VerticalOptions="Center" />
                    <CheckBox x:Name="TransparencyBox" CheckedChanged="OnTransparencyChanged" />
                </HorizontalStackLayout>

                <!-- GA Configuration -->
                <Frame BorderColor="Gray" Padding="10">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="GA Configuration" FontAttributes="Bold" VerticalOptions="Center" />
                            <Button Text="Reset to Default" Clicked="OnResetGAConfigClicked" Padding="5,2" FontSize="12" />
                        </HorizontalStackLayout>

                        <!-- Solver Mode -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Mode:" VerticalOptions="Center" WidthRequest="80" />
                            <Picker x:Name="SolverModePicker" WidthRequest="150" SelectedIndexChanged="OnSolverModeChanged">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Iterative</x:String>
                                        <x:String>Complete</x:String>
                                        <x:String>Adaptive</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </HorizontalStackLayout>

                        <!-- Preset -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Preset:" VerticalOptions="Center" WidthRequest="80" />
                            <Picker x:Name="PresetPicker" WidthRequest="150" SelectedIndexChanged="OnPresetChanged">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Default</x:String>
                                        <x:String>Fast</x:String>
                                        <x:String>Exploratory</x:String>
                                        <x:String>Exploitative</x:String>
                                        <x:String>LongRun</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </HorizontalStackLayout>

                        <!-- Population Size -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Population:" VerticalOptions="Center" WidthRequest="80" />
                            <Slider x:Name="PopulationSlider" Minimum="20" Maximum="500" Value="100" WidthRequest="120" ValueChanged="OnGAParamChanged" />
                            <Label x:Name="PopulationLabel" Text="100" VerticalOptions="Center" WidthRequest="40" />
                        </HorizontalStackLayout>

                        <!-- Mutation Rate -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Mutation:" VerticalOptions="Center" WidthRequest="80" />
                            <Slider x:Name="MutationSlider" Minimum="0" Maximum="1" Value="1.0" WidthRequest="120" ValueChanged="OnGAParamChanged" />
                            <Label x:Name="MutationLabel" Text="100%" VerticalOptions="Center" WidthRequest="40" />
                        </HorizontalStackLayout>

                        <!-- Generations per Iteration -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Generations:" VerticalOptions="Center" WidthRequest="80" />
                            <Slider x:Name="GenerationsSlider" Minimum="10" Maximum="500" Value="100" WidthRequest="120" ValueChanged="OnGAParamChanged" />
                            <Label x:Name="GenerationsLabel" Text="100" VerticalOptions="Center" WidthRequest="40" />
                        </HorizontalStackLayout>

                        <!-- Selection Strategy -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Selection:" VerticalOptions="Center" WidthRequest="80" />
                            <Picker x:Name="SelectionPicker" WidthRequest="150" SelectedIndexChanged="OnSelectionChanged">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Unique</x:String>
                                        <x:String>Tournament</x:String>
                                        <x:String>Rank</x:String>
                                        <x:String>Roulette</x:String>
                                        <x:String>RouletteRank</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </HorizontalStackLayout>

                        <!-- Crossover Strategy -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Crossover:" VerticalOptions="Center" WidthRequest="80" />
                            <Picker x:Name="CrossoverPicker" WidthRequest="150" SelectedIndexChanged="OnCrossoverChanged">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>SinglePoint</x:String>
                                        <x:String>TwoPoint</x:String>
                                        <x:String>Uniform</x:String>
                                        <x:String>SegmentPreserving</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </HorizontalStackLayout>

                        <!-- Mutation Strategy -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Mut. Type:" VerticalOptions="Center" WidthRequest="80" />
                            <Picker x:Name="MutationPicker" WidthRequest="150" SelectedIndexChanged="OnMutationStrategyChanged">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>SingleGene</x:String>
                                        <x:String>Random</x:String>
                                        <x:String>Swap</x:String>
                                        <x:String>Inversion</x:String>
                                        <x:String>Scramble</x:String>
                                        <x:String>Conjugation</x:String>
                                        <x:String>Commutator</x:String>
                                        <x:String>Neighbor</x:String>
                                        <x:String>Simplify</x:String>
                                        <x:String>InverseSequence</x:String>
                                        <x:String>Insert</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </HorizontalStackLayout>

                        <!-- Elite Count -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Elite:" VerticalOptions="Center" WidthRequest="80" />
                            <Slider x:Name="EliteSlider" Minimum="0" Maximum="20" Value="2" WidthRequest="120" ValueChanged="OnGAParamChanged" />
                            <Label x:Name="EliteLabel" Text="2" VerticalOptions="Center" WidthRequest="40" />
                        </HorizontalStackLayout>

                        <!-- Chromosome Length -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Chr. Length:" VerticalOptions="Center" WidthRequest="80" />
                            <Slider x:Name="ChromosomeLengthSlider" Minimum="10" Maximum="200" Value="50" WidthRequest="120" ValueChanged="OnGAParamChanged" />
                            <Label x:Name="ChromosomeLengthLabel" Text="50" VerticalOptions="Center" WidthRequest="40" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Statistics -->
                <Frame BorderColor="Gray" Padding="10">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
                        <Label Text="Error:" Grid.Row="0" Grid.Column="0" />
                        <Label x:Name="ErrorLabel" Text="0" Grid.Row="0" Grid.Column="1" />

                        <Label Text="Time:" Grid.Row="1" Grid.Column="0" />
                        <Label x:Name="TimeLabel" Text="00:00:00" Grid.Row="1" Grid.Column="1" />

                        <Label Text="Moves:" Grid.Row="2" Grid.Column="0" />
                        <Label x:Name="MovesLabel" Text="0" Grid.Row="2" Grid.Column="1" />

                        <Label Text="Solutions:" Grid.Row="3" Grid.Column="0" />
                        <Label x:Name="SolutionLabel" Text="0" Grid.Row="3" Grid.Column="1" />

                        <Label Text="GA Iterations:" Grid.Row="4" Grid.Column="0" />
                        <Label x:Name="GACountLabel" Text="0" Grid.Row="4" Grid.Column="1" />
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Center Panel - Cube View (Native GPU rendering: Metal on macOS, OpenGL on Windows) -->
        <controls:NativeCubeView x:Name="CubeViewControl"
                                 Grid.Column="1"
                                 BackgroundColor="DarkSlateGray">
            <controls:NativeCubeView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnCubeViewPanUpdated" />
                <PinchGestureRecognizer PinchUpdated="OnCubeViewPinchUpdated" />
            </controls:NativeCubeView.GestureRecognizers>
        </controls:NativeCubeView>

        <!-- Right Panel - Charts -->
        <ScrollView Grid.Column="2" Padding="10">
            <VerticalStackLayout Spacing="10">

                <!-- Fitness Chart -->
                <Frame BorderColor="Gray" Padding="5">
                    <VerticalStackLayout>
                        <Label Text="Fitness Chart" FontAttributes="Bold" />
                        <lvc:CartesianChart x:Name="FitnessChart"
                                            HeightRequest="250"
                                            Series="{Binding Series}"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Iteration Time -->
                <Label x:Name="IterTimeLabel" Text="Iter time: 0ms" />

                <!-- State Grid Visualization -->
                <Frame BorderColor="Gray" Padding="5">
                    <VerticalStackLayout>
                        <Label Text="State Grid" FontAttributes="Bold" />
                        <Border Stroke="Gray"
                                StrokeThickness="1"
                                HeightRequest="280"
                                WidthRequest="280"
                                HorizontalOptions="Center"
                                VerticalOptions="Start">
                            <GraphicsView x:Name="StateGridView" />
                        </Border>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
